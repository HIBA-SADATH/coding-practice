def sumo(n,arr):
    i=arr[0]
    if i>0 and i%2!=0:
        if n==1:
            return i
        else:
            return i+sumo(n-1,arr[1:])
    else : 
            if n==1 :
                return 0
            else:
                return sumo(n-1,arr[1:])
n=int(input())
arr=[]
for i in range(n):
    i=int(input())
    arr.append(i)
    
print(f"Sum = {sumo(n,arr)}")
